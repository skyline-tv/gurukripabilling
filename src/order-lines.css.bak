.line-head{display:flex;justify-content:space-between;align-items:center;margin:18px 0 8px;font-size:12px}.add-line{border:0;background:#e9f5ee;color:#126e49;border-radius:5px;padding:6px 9px;font:600 11px 'DM Sans';cursor:pointer}.order-line{display:grid;grid-template-columns:1fr 72px 74px 24px;gap:7px;align-items:center;margin:8px 0}.order-line select,.order-line input{margin:0;padding:8px}.order-line>b{font-size:11px;text-align:right}.remove-line{border:0;background:#fff0ed;color:#c55b46;border-radius:5px;height:28px;font-size:18px;cursor:pointer}@media(max-width:600px){.order-line{grid-template-columns:1fr 60px}.order-line>b{padding:4px 0;text-align:left}.remove-line{grid-column:2}}
