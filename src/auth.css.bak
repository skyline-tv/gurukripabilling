.login-page{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;background:#fafbf9}.login-brand{background:#123f30;color:#fff;padding:clamp(45px,8vw,120px);display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}.login-brand:after{content:'';position:absolute;width:480px;height:480px;border:1px solid #4b806b;border-radius:50%;right:-210px;bottom:-240px}.login-mark,.login-logo>span{display:grid;place-items:center;width:45px;height:45px;border-radius:12px;background:#e4ae47;color:#17412f;font:700 27px 'Playfair Display'}.login-brand>p{margin:23px 0 11px;font-size:10px;letter-spacing:1.6px;color:#aecbbb;font-weight:700}.login-brand h1{font:700 clamp(38px,4.2vw,60px) 'Playfair Display';letter-spacing:-1.5px;line-height:1.05;margin:0}.login-brand h1 span{color:#e9b94f}.login-brand>small{max-width:340px;color:#b2cbc0;font-size:14px;line-height:1.7;margin-top:20px}.login-details{display:grid;gap:5px;margin-top:56px;color:#83ad9b;font-size:11px}.login-panel{display:grid;place-items:center;padding:35px}.login-card{width:min(390px,100%)}.login-logo{display:flex;align-items:center;gap:10px;margin-bottom:43px}.login-logo>span{width:35px;height:35px;border-radius:9px;font-size:20px}.login-logo b{display:block;font:700 17px 'Playfair Display';color:#173b2c}.login-logo small{display:block;color:#8a9991;font-size:8px;letter-spacing:1.8px;margin-top:1px}.login-overline{font-size:10px;letter-spacing:1.3px;color:#168052;font-weight:700;margin:0 0 8px}.login-card h2{font:700 29px 'Playfair Display';margin:0;color:#192d23}.login-sub{font-size:13px;color:#74827b;margin:8px 0 27px}.login-card label{display:block;color:#4d5d54;font-size:11px;font-weight:700;margin:15px 0}.login-card input{display:block;width:100%;border:1px solid #dce5df;border-radius:7px;background:#fff;padding:12px;margin-top:7px;font:13px 'DM Sans';outline-color:#11724b}.login-submit{width:100%;background:#11724b;color:#fff;border:0;border-radius:7px;padding:13px;margin-top:9px;font:700 13px 'DM Sans';cursor:pointer}.login-submit:disabled{opacity:.65;cursor:wait}.login-error,.login-setup{border-radius:6px;padding:10px 11px;font-size:11px;line-height:1.45}.login-error{background:#fcecea;color:#a44337}.login-setup{background:#fff5e3;color:#856021}.login-setup code{font-family:monospace}.login-help{text-align:center;color:#8a9690;font-size:11px;margin-top:17px}@media(max-width:760px){.login-page{grid-template-columns:1fr}.login-brand{min-height:270px;padding:38px}.login-brand h1{font-size:38px}.login-brand>small,.login-details{display:none}.login-panel{padding:36px 24px}.login-logo{margin-bottom:28px}}
